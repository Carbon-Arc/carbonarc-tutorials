# CarbonArc API Configuration
# Get your API token from: https://app.carbonarc.co/my/profile
API_AUTH_TOKEN=<your-api-token>
API_BASE_URL=https://api.carbonarc.co

# AWS Credentials (required for bulk data access)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_DEFAULT_REGION=us-east-1
